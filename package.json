{
  "name": "gamemulti",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "apps/api",
    "plugin-poc/minecraft-js"
  ],
  "scripts": {
    "build:api": "npm --workspace apps/api run build",
    "check:api-prod-build": "npm run build:api && node -e \"require('node:fs').accessSync('apps/api/dist/main.js')\"",
    "build:web": "npm --workspace apps/web run build",
    "dev:api": "npm --workspace apps/api run start:dev",
    "dev:web": "npm --workspace apps/web run dev",
    "prisma:generate": "npm --workspace apps/api run prisma:generate",
    "prisma:migrate": "npm --workspace apps/api run prisma:migrate",
    "smoke:web-api": "node scripts/smoke-web-api.mjs",
    "smoke:bridge-api": "node scripts/smoke-bridge-api.mjs",
    "smoke:plugin-install": "node scripts/smoke-plugin-install.mjs",
    "check:local-discourse": "node scripts/check-local-discourse-sso.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
