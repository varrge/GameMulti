# GameMulti infra compose example
APP_NAME=gamemulti
NODE_ENV=development
APP_SECRET=replace-with-a-long-random-secret
ADMIN_API_KEY=replace-with-a-long-random-admin-key
ADMIN_USER_IDS=
ADMIN_USERNAMES=
NPM_CONFIG_REGISTRY=https://registry.npmmirror.com

# Public app/API URLs as seen from a browser.
APP_URL=http://localhost:8080
API_URL=http://localhost:8080/api

# Web app
WEB_SOURCE_DIR=/absolute/path/to/GameMulti/apps/web
WEB_PORT=3301
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_FORUM_ORIGIN=https://bbs.example.com
NEXT_PUBLIC_FORUM_ENTRY_PATH=/

# API app
API_PORT=3401
DATABASE_URL=postgresql://gamemulti:changeme@postgres:5432/gamemulti?schema=public
FORUM_ORIGIN=https://bbs.example.com
FORUM_ENTRY_PATH=/

# Public entry
HOST_HTTP_PORT=8080

# Postgres
POSTGRES_DB=gamemulti
POSTGRES_USER=gamemulti
POSTGRES_PASSWORD=changeme

# Optional queue service (profile=queue)
REDIS_URL=redis://redis:6379/0
