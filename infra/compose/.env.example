# GameMulti infra compose example
APP_NAME=gamemulti
NODE_ENV=production
# up.sh auto-generates placeholder secrets on first deployment and prints them
# once. Save the first-run output privately.
APP_SECRET=replace-with-a-long-random-secret
ADMIN_API_KEY=replace-with-a-long-random-admin-key
ADMIN_USER_IDS=
ADMIN_USERNAMES=
NPM_CONFIG_REGISTRY=https://registry.npmmirror.com

# Public app/API URLs as seen from a browser.
# Fill PUBLIC_ORIGIN once. up.sh derives APP_URL and API_URL from it unless
# explicitly overridden.
PUBLIC_ORIGIN=http://localhost:8080
# APP_URL=http://localhost:8080
# API_URL=http://localhost:8080/api
# Bridge uses this to build Discourse provider callback URLs. up.sh derives it
# from PUBLIC_ORIGIN unless explicitly overridden.
# BRIDGE_PUBLIC_ORIGIN=http://localhost:8080

# Optional web app. Default deployment does not start Next.js.
# Set ENABLE_WEB=1 or COMPOSE_PROFILES=web to deploy it.
ENABLE_WEB=0
# NGINX_CONF=../nginx/with-web.conf
# WEB_SOURCE_DIR=/absolute/path/to/GameMulti/apps/web
WEB_PORT=3301
NEXT_PUBLIC_API_BASE_URL=/api

# API app
API_PORT=3401
DATABASE_URL=postgresql://gamemulti:changeme@postgres:5432/gamemulti?schema=public
FORUM_PROVIDER=discourse
# Fill FORUM_ORIGIN once. up.sh derives NEXT_PUBLIC_FORUM_ORIGIN from it unless
# explicitly overridden.
FORUM_ORIGIN=https://bbs.example.com
FORUM_ENTRY_PATH=/
# Used for Discourse provider SSO. The Bridge reuses this as the provider
# secret unless DISCOURSE_PROVIDER_SECRET is explicitly set.
FORUM_SSO_SECRET=replace-with-a-long-random-forum-sso-secret
# DISCOURSE_PROVIDER_SECRET=replace-with-a-long-random-forum-sso-secret
# NEXT_PUBLIC_FORUM_ORIGIN=https://bbs.example.com
# NEXT_PUBLIC_FORUM_ENTRY_PATH=/

# Public entry
# A plain port publishes on every IPv4 interface. Behind the GameMulti 1Panel
# edge, bind the fixed VM LAN address instead: 192.168.110.243:1051.
HOST_HTTP_PORT=8080
# NGINX_CONF=../nginx/onepanel-origin.conf

# Online update
DEPLOY_REMOTE=origin
DEPLOY_BRANCH=develop
DEPLOY_UPDATE_MODE=ff-only
DEPLOY_HEALTH_URL=http://127.0.0.1:8080/api/healthz
DEPLOY_HEALTH_ATTEMPTS=30
DEPLOY_HEALTH_DELAY_SECONDS=3
DEPLOY_AGENT_URL=http://host.docker.internal:3421
DEPLOY_AGENT_TOKEN=replace-with-a-long-random-deploy-agent-token
DEPLOY_AGENT_PORT=3421

# Postgres
POSTGRES_DB=gamemulti
POSTGRES_USER=gamemulti
POSTGRES_PASSWORD=changeme

# Optional queue service (profile=queue)
REDIS_URL=redis://redis:6379/0
