# GameMulti infra compose example
APP_NAME=gamemulti
NODE_ENV=development
APP_SECRET=replace-with-a-long-random-secret
ADMIN_API_KEY=replace-with-a-long-random-admin-key
ADMIN_USER_IDS=
ADMIN_USERNAMES=
NPM_CONFIG_REGISTRY=https://registry.npmmirror.com

# Public app/API URLs as seen from a browser.
# Fill PUBLIC_ORIGIN once. up.sh derives APP_URL and API_URL from it unless
# explicitly overridden.
PUBLIC_ORIGIN=http://localhost:8080
# APP_URL=http://localhost:8080
# API_URL=http://localhost:8080/api

# Web app
WEB_SOURCE_DIR=/absolute/path/to/GameMulti/apps/web
WEB_PORT=3301
NEXT_PUBLIC_API_BASE_URL=/api

# API app
API_PORT=3401
DATABASE_URL=postgresql://gamemulti:changeme@postgres:5432/gamemulti?schema=public
FORUM_PROVIDER=discourse
# Fill FORUM_ORIGIN once. up.sh derives NEXT_PUBLIC_FORUM_ORIGIN from it unless
# explicitly overridden.
FORUM_ORIGIN=https://bbs.example.com
FORUM_ENTRY_PATH=/
FORUM_SSO_SECRET=replace-with-a-long-random-forum-sso-secret
# FORUM_SSO_RETURN_URL=http://localhost:8080/forums/discourse-connect
# NEXT_PUBLIC_FORUM_ORIGIN=https://bbs.example.com
# NEXT_PUBLIC_FORUM_ENTRY_PATH=/

# Public entry
HOST_HTTP_PORT=8080

# Online update
DEPLOY_REMOTE=origin
DEPLOY_BRANCH=develop
DEPLOY_UPDATE_MODE=ff-only
DEPLOY_HEALTH_URL=http://127.0.0.1:8080/api/healthz
DEPLOY_HEALTH_ATTEMPTS=30
DEPLOY_HEALTH_DELAY_SECONDS=3

# Postgres
POSTGRES_DB=gamemulti
POSTGRES_USER=gamemulti
POSTGRES_PASSWORD=changeme

# Optional queue service (profile=queue)
REDIS_URL=redis://redis:6379/0
