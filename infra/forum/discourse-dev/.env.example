POSTGRES_DB=discourse_dev
POSTGRES_USER=discourse
POSTGRES_PASSWORD=replace-with-local-postgres-password
DISCOURSE_HTTP_PORT=80
# Use localhost for same-machine local validation. Use auto-public for
# server-like validation, auto-local for LAN testing, or an explicit hostname.
DISCOURSE_HOSTNAME=localhost
DISCOURSE_DEVELOPER_EMAILS=admin@example.com
DISCOURSE_LOCAL_ADMIN_EMAIL=admin@example.com
DISCOURSE_LOCAL_SITE_NAME=GameMulti Local Forum
DISCOURSE_DEFAULT_LOCALE=zh_CN
DISCOURSE_ALLOW_USER_LOCALE=true

# Used by `dev.sh configure-local-sso`. Keep this secret aligned with
# infra/compose/.env for local GameMulti.
FORUM_SSO_SECRET=local-dev-forum-sso-secret
BRIDGE_PUBLIC_ORIGIN=http://127.0.0.1:8080
DISCOURSE_PROVIDER_SECRET=local-dev-forum-sso-secret

# Local Discourse still expects SMTP variables. For real mail testing, use a
# disposable SMTP sandbox or your provider credentials in the ignored .env file.
DISCOURSE_SMTP_ADDRESS=smtp.example.com
DISCOURSE_SMTP_PORT=587
DISCOURSE_SMTP_USER_NAME=postmaster@example.com
DISCOURSE_SMTP_PASSWORD=replace-with-smtp-password
DISCOURSE_SMTP_ENABLE_START_TLS=true
DISCOURSE_SMTP_OPENSSL_VERIFY_MODE=none
DISCOURSE_SMTP_AUTHENTICATION=plain
DISCOURSE_NOTIFICATION_EMAIL=noreply@example.com
DISCOURSE_NOTIFICATION_EMAIL_NAME=GameMulti Local Forum
