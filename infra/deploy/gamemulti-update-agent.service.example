[Unit]
Description=GameMulti Update Agent
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/GameMulti
EnvironmentFile=/opt/GameMulti/infra/compose/.env
Environment=DEPLOY_AGENT_HOST=0.0.0.0
Environment=DEPLOY_AGENT_PORT=3421
ExecStart=/usr/bin/node /opt/GameMulti/infra/deploy/update_agent.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
