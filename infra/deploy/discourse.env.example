# GameMulti Discourse production deployment example
#
# Copy to a private env file on the deployment host, for example:
#   cp infra/deploy/discourse.env.example infra/deploy/discourse.env
#
# Do not commit the filled file. Values marked secret must be generated per
# environment and stored only on the server, CI secrets, or a secret manager.

# Public domains. The forum should normally run on a separate hostname.
GAME_PUBLIC_ORIGIN=https://app.example.com
BRIDGE_PUBLIC_ORIGIN=https://app.example.com
DISCOURSE_HOSTNAME=forum.example.com

# Discourse bootstrap/admin contact.
DISCOURSE_DEVELOPER_EMAILS=admin@example.com
LETSENCRYPT_ACCOUNT_EMAIL=admin@example.com
DISCOURSE_DEFAULT_LOCALE=zh_CN
DISCOURSE_ALLOW_USER_LOCALE=true

# SMTP is required for a production Discourse install.
DISCOURSE_SMTP_ADDRESS=smtp.example.com
DISCOURSE_SMTP_PORT=587
DISCOURSE_SMTP_USER_NAME=postmaster@example.com
DISCOURSE_SMTP_PASSWORD=replace-with-smtp-password
DISCOURSE_SMTP_ENABLE_START_TLS=true
DISCOURSE_NOTIFICATION_EMAIL=noreply@example.com

# DiscourseConnect / SSO.
# secret: generate with `openssl rand -hex 32`
# The Bridge uses this for Discourse provider SSO unless DISCOURSE_PROVIDER_SECRET
# is explicitly set.
FORUM_PROVIDER=discourse
FORUM_ENTRY_PATH=/
FORUM_SSO_SECRET=replace-with-64-hex-random-secret
# Optional. Defaults to FORUM_SSO_SECRET when omitted.
# DISCOURSE_PROVIDER_SECRET=replace-with-64-hex-random-secret
NEXT_PUBLIC_FORUM_ENTRY_PATH=/

# Optional: used only by local helper scripts for live checks.
CHECK_HTTP_PORT=80
CHECK_HTTPS_PORT=443

# Optional: official discourse_docker container name on the forum host.
DISCOURSE_CONTAINER=app

# Optional: forum topic created by discourse_configure_sso.sh.
GAMEMULTI_FORUM_CATEGORY_NAME=游戏绑定
GAMEMULTI_FORUM_TOPIC_TITLE=游戏绑定与服务器接入
